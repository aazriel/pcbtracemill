{
  "name": "tracemill",
  "productName": "TraceMill",
  "version": "0.1.0",
  "description": "TraceMill - PCB Gerber to G-Code CAM Studio",
  "author": {
    "name": "TraceMill contributors",
    "email": "noreply@tracemill.io"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clipper2-ts": "^2.0.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "d3-scale-chromatic": "^3.1.1",
    "delaunator": "^5.0.1",
    "earcut": "^3.2.4",
    "electron-store": "^8.2.0",
    "immer": "^10.2.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.170.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56",
    "@tailwindcss/vite": "^4.3.4",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/delaunator": "^5.0.3",
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "homepage": "https://github.com/tracemill/tracemill",
  "desktopName": "tracemill.desktop"
}
